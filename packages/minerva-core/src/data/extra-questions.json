[
  {"id":"lesson-frac-001","section":"math_knowledge","scopeClassification":"prerequisite_skill","skillTag":"fractions","difficulty":1,"prompt":"What is 1/2 + 1/4?","answerChoices":["1/6","2/6","3/4","3/6"],"correctAnswer":"3/4","explanation":"1/2 = 2/4. 2/4 + 1/4 = 3/4.","estimatedSolveTimeSec":25,"commonTrap":"Adding numerators and denominators directly.","prerequisites":["addition"]},
  {"id":"lesson-frac-002","section":"math_knowledge","scopeClassification":"prerequisite_skill","skillTag":"fractions","difficulty":2,"prompt":"Which is larger: 3/5 or 2/3?","answerChoices":["3/5","2/3","Equal","Cannot tell"],"correctAnswer":"2/3","explanation":"3/5 = 0.6, 2/3 ≈ 0.67.","estimatedSolveTimeSec":30,"commonTrap":"Assuming larger denominator means larger fraction.","prerequisites":["fractions"]},
  {"id":"lesson-frac-003","section":"math_knowledge","scopeClassification":"prerequisite_skill","skillTag":"fractions","difficulty":2,"prompt":"Convert 3/8 to a decimal.","answerChoices":["0.375","0.38","0.83","3.8"],"correctAnswer":"0.375","explanation":"3 ÷ 8 = 0.375.","estimatedSolveTimeSec":35,"commonTrap":"Dividing 8 by 3.","prerequisites":["division"]},
  {"id":"lesson-ratio-001","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"ratios","difficulty":2,"prompt":"A class has 12 boys and 8 girls. What is the ratio of boys to girls?","answerChoices":["12:8","8:12","3:2","2:3"],"correctAnswer":"3:2","explanation":"12:8 simplifies to 3:2.","estimatedSolveTimeSec":30,"commonTrap":"Reversing the ratio order.","prerequisites":["fractions"]},
  {"id":"lesson-ratio-002","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"ratios","difficulty":2,"prompt":"If 2:5 = x:20, what is x?","answerChoices":["4","5","8","10"],"correctAnswer":"8","explanation":"Scale factor 4: 2×4=8, 5×4=20.","estimatedSolveTimeSec":40,"commonTrap":"Using addition instead of scaling.","prerequisites":["ratios"]},
  {"id":"lesson-ratio-003","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"ratios","difficulty":3,"prompt":"A car uses 4 gallons for 100 miles. How many gallons for 250 miles?","answerChoices":["8","10","12","16"],"correctAnswer":"10","explanation":"Rate 25 mpg... 100/4=25 miles/gal. 250/25=10 gallons.","estimatedSolveTimeSec":50,"commonTrap":"Multiplying 4×250 without finding rate.","prerequisites":["ratios","proportions"]},
  {"id":"lesson-wp-001","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"word_problem_translation","difficulty":2,"prompt":"Tom has $45. He spends $18. How much remains?","answerChoices":["$23","$27","$33","$63"],"correctAnswer":"$27","explanation":"45 - 18 = 27.","estimatedSolveTimeSec":25,"commonTrap":"Adding instead of subtracting.","prerequisites":["subtraction"]},
  {"id":"lesson-wp-002","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"word_problem_translation","difficulty":3,"prompt":"A plane flies 420 miles in 3 hours. What is its average speed?","answerChoices":["120 mph","140 mph","1260 mph","210 mph"],"correctAnswer":"140 mph","explanation":"420 ÷ 3 = 140 mph.","estimatedSolveTimeSec":40,"commonTrap":"Multiplying 420×3.","prerequisites":["division"]},
  {"id":"lesson-wp-003","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"word_problem_translation","difficulty":3,"prompt":"5 workers finish a job in 12 days. How long for 3 workers (same rate)?","answerChoices":["7.2 days","20 days","15 days","8 days"],"correctAnswer":"20 days","explanation":"Total work = 60 worker-days. 60÷3 = 20 days.","estimatedSolveTimeSec":55,"commonTrap":"Using direct proportion instead of inverse.","prerequisites":["ratios"]},
  {"id":"lesson-prop-001","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"proportions","difficulty":2,"prompt":"If 3 pencils cost $1.50, how much for 8 pencils?","answerChoices":["$3.50","$4.00","$4.50","$5.00"],"correctAnswer":"$4.00","explanation":"$0.50 each × 8 = $4.00.","estimatedSolveTimeSec":35,"commonTrap":"Not finding unit price first.","prerequisites":["ratios"]},
  {"id":"lesson-prop-002","section":"arithmetic_reasoning","scopeClassification":"official_arithmetic_reasoning","skillTag":"proportions","difficulty":3,"prompt":"A map scale is 1 inch = 15 miles. Two cities are 4.5 inches apart. Distance?","answerChoices":["60 mi","67.5 mi","19.5 mi","45 mi"],"correctAnswer":"67.5 mi","explanation":"4.5 × 15 = 67.5 miles.","estimatedSolveTimeSec":40,"commonTrap":"Dividing instead of multiplying.","prerequisites":["ratios"]},
  {"id":"lesson-mix-001","section":"arithmetic_reasoning","scopeClassification":"direct_sample_archetype","skillTag":"proportions","difficulty":3,"prompt":"Mix 40% acid solution with pure water to get 2L of 10% solution. How much acid solution?","answerChoices":["0.5 L","1.0 L","0.25 L","1.5 L"],"correctAnswer":"0.5 L","explanation":"0.4x = 0.10×2, x = 0.5 L.","estimatedSolveTimeSec":60,"commonTrap":"Averaging percentages without weighting.","prerequisites":["percentages","proportions"]},
  {"id":"lesson-unit-001","section":"arithmetic_reasoning","scopeClassification":"prerequisite_skill","skillTag":"word_problem_translation","difficulty":2,"prompt":"Convert 5 feet to inches.","answerChoices":["50 in","60 in","12 in","48 in"],"correctAnswer":"60 in","explanation":"5 × 12 = 60 inches.","estimatedSolveTimeSec":20,"commonTrap":"Dividing by 12.","prerequisites":["multiplication"]},
  {"id":"lesson-lin-001","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"linear_equations","difficulty":2,"prompt":"Solve: x + 7 = 15","answerChoices":["x = 7","x = 8","x = 22","x = 9"],"correctAnswer":"x = 8","explanation":"x = 15 - 7 = 8.","estimatedSolveTimeSec":25,"commonTrap":"Adding 7 to both sides incorrectly.","prerequisites":["subtraction"]},
  {"id":"lesson-lin-002","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"linear_equations","difficulty":2,"prompt":"Solve: 3x = 21","answerChoices":["x = 3","x = 7","x = 18","x = 24"],"correctAnswer":"x = 7","explanation":"x = 21 ÷ 3 = 7.","estimatedSolveTimeSec":25,"commonTrap":"Subtracting 3 instead of dividing.","prerequisites":["division"]},
  {"id":"lesson-lin-003","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"linear_equations","difficulty":3,"prompt":"Solve: 2x - 4 = 10","answerChoices":["x = 3","x = 7","x = 5","x = 14"],"correctAnswer":"x = 7","explanation":"2x = 14, x = 7.","estimatedSolveTimeSec":35,"commonTrap":"Adding 4 to 10 only on one side incorrectly.","prerequisites":["linear_equations"]},
  {"id":"lesson-ineq-001","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"inequalities","difficulty":2,"prompt":"Which satisfies x - 3 > 5?","answerChoices":["x = 7","x = 8","x = 9","x = 5"],"correctAnswer":"x = 9","explanation":"x > 8. Only 9 works.","estimatedSolveTimeSec":30,"commonTrap":"Treating > as ≥.","prerequisites":["linear_equations"]},
  {"id":"lesson-ineq-002","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"inequalities","difficulty":3,"prompt":"Solve: -2x < 8","answerChoices":["x < -4","x > -4","x < 4","x > 4"],"correctAnswer":"x > -4","explanation":"Divide by -2, flip sign: x > -4.","estimatedSolveTimeSec":40,"commonTrap":"Forgetting to flip the inequality sign.","prerequisites":["inequalities"]},
  {"id":"lesson-alg-001","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"algebra_expressions","difficulty":2,"prompt":"Simplify: 3x + 2x","answerChoices":["5x","6x","5x²","3x²"],"correctAnswer":"5x","explanation":"Combine like terms: 3x + 2x = 5x.","estimatedSolveTimeSec":20,"commonTrap":"Multiplying coefficients.","prerequisites":["multiplication"]},
  {"id":"lesson-alg-002","section":"math_knowledge","scopeClassification":"direct_sample_archetype","skillTag":"algebra_expressions","difficulty":3,"prompt":"Factor: x² - 9","answerChoices":["(x-3)²","(x+3)(x-3)","(x+9)(x-1)","x(x-9)"],"correctAnswer":"(x+3)(x-3)","explanation":"Difference of squares: x² - 9 = (x+3)(x-3).","estimatedSolveTimeSec":45,"commonTrap":"Using perfect square trinomial pattern incorrectly.","prerequisites":["exponents"]},
