  {"id":"lesson-geo-001","section":"math_knowledge","scopeClassification":"official_math_knowledge","skillTag":"geometry_formulas","difficulty":2,"prompt":"Area of a square with side 9?","answerChoices":["18","36","81","72"],"correctAnswer":"81","explanation":"A = s² = 9² = 81.","estimatedSolveTimeSec":25,"commonTrap":"Multiplying side by 4 (perimeter).","prerequisites":["multiplication"]},
