rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /game/{docId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /profiles/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attempts/{attemptId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /mastery/{userId}/skills/{skillTag} {
      allow read, write: if isOwner(userId);
    }

    match /missions/{userId}/daily/{date} {
      allow read, write: if isOwner(userId);
    }

    match /officerTrials/{userId}/sessions/{sessionId} {
      allow read, write: if isOwner(userId);
    }

    match /afterActionReviews/{userId}/reviews/{reviewId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if false;
    }

    match /generatedQuestionValidation/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
